{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Core, dialog and opener permissions for the main and detached windows.",
  "windows": ["main", "detached-*"],
  "permissions": [
    "core:default",
    "core:webview:allow-create-webview-window",
    "dialog:default",
    "opener:default",
    "opener:allow-open-path"
  ]
}
