{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LinuxSCP Client",
  "version": "0.1.0",
  "identifier": "dev.boondock.linuxscp",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "LinuxSCP Client",
        "width": 1240,
        "height": 800,
        "minWidth": 860,
        "minHeight": 540
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png"
    ],
    "category": "Utility",
    "shortDescription": "Dual-pane SFTP/SCP file transfer client",
    "longDescription": "LinuxSCP Client is a dual-pane file transfer client for SFTP with saved sessions, a background transfer queue, and secure credential storage via the system keyring.",
    "linux": {
      "deb": { "depends": [] },
      "rpm": { "depends": [] }
    }
  }
}
