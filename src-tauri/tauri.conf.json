{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Boon Transfer",
  "mainBinaryName": "boon-transfer",
  "version": "1.0.0",
  "identifier": "os.boon.transfer",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "BooN Transfer",
        "width": 1240,
        "height": 800,
        "minWidth": 860,
        "minHeight": 540
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["deb", "rpm", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "shortDescription": "Dual-pane SFTP/SCP/FTP/FTPS file transfer client",
    "longDescription": "BooN Transfer is a dual-pane file transfer client for SFTP, SCP, FTP and FTPS with saved sessions, a background transfer queue with pause/resume, directory synchronisation, a built-in editor, and secure credential storage via the system keyring. Built on russh and rustls — no OpenSSL, no libssh2.",
    "linux": {
      "deb": {
        "depends": [],
        "desktopTemplate": "../packaging/linux/boon-transfer.desktop.hbs"
      },
      "rpm": {
        "depends": [],
        "desktopTemplate": "../packaging/linux/boon-transfer.desktop.hbs"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFGOEU2QjJDNDBGQzVGOUUKUldTZVgveEFMR3VPcjI0WklCVHZ5ZFVsN1BqeitwUmxvbXF5dlpkWHFTQWFZMUdiYW0vVm92RHoK",
      "endpoints": [
        "https://github.com/BoondockSulfur/BooNTransfer/releases/latest/download/latest.json"
      ]
    }
  }
}
